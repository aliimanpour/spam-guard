<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      No action bar (Compose draws everything) and no window animations, so
      opening the app and navigating back never wait on an activity transition.
    -->
    <style name="Theme.SmsSpam" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowAnimationStyle">@style/NoWindowAnimation</item>
    </style>

    <style name="NoWindowAnimation" parent="@android:style/Animation.Activity">
        <item name="android:activityOpenEnterAnimation">@null</item>
        <item name="android:activityOpenExitAnimation">@null</item>
        <item name="android:activityCloseEnterAnimation">@null</item>
        <item name="android:activityCloseExitAnimation">@null</item>
    </style>
</resources>
